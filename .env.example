# 이 파일을 .env 로 복사해서 사용하세요. (.env 는 Git에 올라가지 않습니다)

# 좌석 데이터: mock(모의 DEMO 데이터) | official(공식 연동 - 현재 비활성)
SEAT_PROVIDER=mock

# 서버 주소. 127.0.0.1 = 이 PC에서만 접속 가능 (권장)
HOST=127.0.0.1
PORT=8000

# 모니터링 조회 간격(초)과 최소값. 최소값은 코드에서 10초 미만으로 내려가지 않습니다 (10 미만은 10으로 조정).
MONITOR_INTERVAL_SECONDS=30
MONITOR_MIN_INTERVAL_SECONDS=10
# 연속 실패 시 자동 중지 횟수
MONITOR_MAX_FAILURES=5
# 같은 좌석 재알림 최소 간격(초)
NOTIFY_COOLDOWN_SECONDS=300
# 프로그램 재시작 시 이전 모니터링 자동 재개 (1/0)
MONITOR_AUTOSTART=1

# 공식 좌석 배정을 위해 열 페이지
OFFICIAL_SEAT_URL=https://lib.inha.ac.kr

# 데이터베이스 위치 (기본: data/seat_manager.db)
# DB_PATH=

# 학교 계정 정보는 현재 필요하지 않습니다. 여기에 비밀번호를 적지 마세요.
